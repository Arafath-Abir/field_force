<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_ffm_expense_statement_pdf" model="ir.actions.report">
        <field name="name">Monthly Expense Statement (PDF)</field>
        <field name="model">ffm.expense.statement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ffm_daily_report.report_expense_statement_pdf_document</field>
        <field name="report_file">ffm_daily_report.report_expense_statement_pdf_document</field>
        <field name="print_report_name">'Monthly_Statement_%s_%s_%s' % (object.employee_id.name, object.year, object.month)</field>
        <field name="binding_model_id" ref="model_ffm_expense_statement"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_expense_statement_pdf_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article" style="font-family: 'Nirmala UI', 'Vrinda', 'Segoe UI', Arial, sans-serif; font-size: 11px; color: #111; line-height: 1.3; padding: 15px;">
                    <style type="text/css">
                        @font-face {
                            font-family: 'Nirmala UI';
                            src: local('Nirmala UI'), local('Vrinda');
                        }
                        body, table, td, th, p, span, div, h1, h2, h3, h4 {
                            font-family: 'Nirmala UI', 'Vrinda', 'Segoe UI', Arial, sans-serif !important;
                        }
                        .statement-header {
                            text-align: center;
                            border-bottom: 2px solid #107c41;
                            padding-bottom: 8px;
                            margin-bottom: 12px;
                        }
                        .company-name {
                            font-size: 18px;
                            font-weight: bold;
                            color: #107c41;
                            margin: 0;
                            text-transform: uppercase;
                        }
                        .report-title {
                            font-size: 14px;
                            font-weight: bold;
                            color: #333;
                            margin-top: 4px;
                        }
                        .info-table {
                            width: 100%;
                            margin-bottom: 12px;
                            border-collapse: collapse;
                        }
                        .info-table td {
                            padding: 3px 6px;
                            font-size: 11px;
                        }
                        .info-label {
                            font-weight: bold;
                            color: #333;
                            width: 15%;
                        }
                        .info-val {
                            color: #111;
                            width: 35%;
                            border-bottom: 1px dotted #ccc;
                        }
                        .data-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 12px;
                            font-size: 10px;
                        }
                        .data-table th {
                            background-color: #f2f7f4;
                            color: #107c41;
                            border: 1px solid #c2d9cc;
                            padding: 4px 6px;
                            text-align: center;
                            font-weight: bold;
                        }
                        .data-table td {
                            border: 1px solid #ddd;
                            padding: 4px 6px;
                        }
                        .total-row {
                            font-weight: bold;
                            background-color: #f8fafc;
                        }
                        .summary-box {
                            background-color: #e8f5e9;
                            border: 2px solid #107c41;
                            border-radius: 6px;
                            padding: 10px;
                            text-align: right;
                            margin-bottom: 15px;
                        }
                        .sig-table {
                            width: 100%;
                            margin-top: 25px;
                            border-collapse: collapse;
                        }
                        .sig-table td {
                            text-align: center;
                            width: 25%;
                            vertical-align: top;
                            padding: 0 10px;
                        }
                        .sig-line {
                            border-top: 1px solid #555;
                            margin-top: 35px;
                            padding-top: 4px;
                            font-size: 10px;
                            font-weight: bold;
                        }
                    </style>

                    <!-- Header -->
                    <div class="statement-header">
                        <div class="company-name">Newtec Pharmaceuticals Limited</div>
                        <div class="report-title">MONTHLY EXPENSE STATEMENT</div>
                    </div>

                    <!-- Meta Info Table -->
                    <table class="info-table">
                        <tr>
                            <td class="info-label">Employee Name:</td>
                            <td class="info-val"><t t-esc="doc.employee_id.name"/></td>
                            <td class="info-label">Month &amp; Year:</td>
                            <td class="info-val">
                                <t t-esc="doc.month"/>/<t t-esc="doc.year"/>
                                (<t t-esc="dict(doc._fields['month'].selection).get(doc.month)"/>)
                            </td>
                        </tr>
                        <tr>
                            <td class="info-label">Designation:</td>
                            <td class="info-val"><t t-esc="doc.job_id.name or '-'"/></td>
                            <td class="info-label">HQ / Branch:</td>
                            <td class="info-val"><t t-esc="doc.branch_id.name or '-'"/></td>
                        </tr>
                        <tr>
                            <td class="info-label">Territory / Area:</td>
                            <td class="info-val"><t t-esc="doc.territory_id.name or '-'"/></td>
                            <td class="info-label">Status:</td>
                            <td class="info-val" style="font-weight: bold; text-transform: uppercase;">
                                <t t-esc="doc.state"/>
                            </td>
                        </tr>
                    </table>

                    <!-- 1. Daily Table (T.A. + D.A.) -->
                    <div style="font-weight: bold; color: #107c41; margin-bottom: 4px; font-size: 11px;">
                        1. Daily T.A. &amp; D.A. Breakdown
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 10%;">Date</th>
                                <th style="width: 50%;">Visited Places</th>
                                <th style="width: 12%; text-align: right;">T.A. (Tk)</th>
                                <th style="width: 12%; text-align: right;">D.A. (Tk)</th>
                                <th style="width: 16%; text-align: right;">Day Total (Tk)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <tr>
                                    <td style="text-align: center;"><t t-esc="line.date"/></td>
                                    <td><t t-esc="line.visited_places"/></td>
                                    <td style="text-align: right;"><t t-esc="'%.2f' % line.ta_amount"/></td>
                                    <td style="text-align: right;"><t t-esc="'%.2f' % line.da_amount"/></td>
                                    <td style="text-align: right; font-weight: bold;"><t t-esc="'%.2f' % line.day_total"/></td>
                                </tr>
                            </t>
                            <t t-if="not doc.line_ids">
                                <tr>
                                    <td colspan="5" style="text-align: center; color: #777;">No daily records found.</td>
                                </tr>
                            </t>
                            <tr class="total-row">
                                <td colspan="2" style="text-align: right;">Daily Table Total:</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.total_daily_ta"/></td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.total_daily_da"/></td>
                                <td style="text-align: right; color: #107c41;"><t t-esc="'%.2f' % doc.total_daily_table"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 2. Other Expenses (Vouchers 1-9) -->
                    <div style="font-weight: bold; color: #107c41; margin-bottom: 4px; font-size: 11px;">
                        2. Other Expenses Breakdown (Vouchers 1 to 9)
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 10%;">SL</th>
                                <th style="width: 65%;">Expense Category</th>
                                <th style="width: 25%; text-align: right;">Amount (Tk)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="text-align: center;">1</td>
                                <td>Entertainment Expense (Voucher Required)</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_entertainment"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">2</td>
                                <td>Postage &amp; Courier Expense (Voucher Required)</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_courier"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">3</td>
                                <td>Photocopy Expense (Voucher Required)</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_photocopy"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">4</td>
                                <td>Promotion Expense</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_promotion"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">5</td>
                                <td>Stationery Expense</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_stationery"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">6</td>
                                <td>Carrying Charge</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_carrying"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">7</td>
                                <td>Banking Charge</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_banking"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">8</td>
                                <td>Hotel Rent Expense (Voucher Required)</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.other_hotel_rent"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">9</td>
                                <td>Motorcycle Maintenance (Fixed by Designation)</td>
                                <td style="text-align: right;"><t t-esc="'%.2f' % doc.motorcycle_maintenance"/></td>
                            </tr>
                            <tr class="total-row">
                                <td colspan="2" style="text-align: right;">Total Other Expenses:</td>
                                <td style="text-align: right; color: #107c41;"><t t-esc="'%.2f' % doc.total_other_expenses"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Grand Total Summary Box -->
                    <div class="summary-box">
                        <span style="font-size: 13px; font-weight: bold; color: #107c41;">
                            GRAND TOTAL EXPENSES:
                        </span>
                        <span style="font-size: 16px; font-weight: bold; color: #107c41; margin-left: 10px;">
                            Tk <t t-esc="'%.2f' % doc.grand_total"/>
                        </span>
                    </div>

                    <!-- Remarks if any -->
                    <t t-if="doc.remarks">
                        <div style="font-size: 10px; margin-bottom: 12px; background: #fafafa; border: 1px solid #e0e0e0; padding: 6px; border-radius: 4px;">
                            <strong>Employee Remarks: </strong><t t-esc="doc.remarks"/>
                        </div>
                    </t>

                    <!-- Signatures Block -->
                    <table class="sig-table">
                        <tr>
                            <td>
                                <div class="sig-line">
                                    Applicant Employee<br/>
                                    <strong><t t-esc="doc.employee_id.name"/></strong><br/>
                                    <span style="font-size: 8px; color: #666;">
                                        <t t-if="doc.submitted_date">Date: <t t-esc="doc.submitted_date.strftime('%Y-%m-%d %H:%M')"/></t>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="sig-line">
                                    Verified by (ASM/RSM)<br/>
                                    <strong><t t-esc="doc.checked_by.name or ''"/></strong><br/>
                                    <span style="font-size: 8px; color: #666;">
                                        <t t-if="doc.checked_date">Date: <t t-esc="doc.checked_date.strftime('%Y-%m-%d %H:%M')"/></t>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="sig-line">
                                    Approved by (NSM/Director)<br/>
                                    <strong><t t-esc="doc.approved_by.name or ''"/></strong><br/>
                                    <span style="font-size: 8px; color: #666;">
                                        <t t-if="doc.approved_date">Date: <t t-esc="doc.approved_date.strftime('%Y-%m-%d %H:%M')"/></t>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="sig-line">
                                    Accounts Department (Disbursed)<br/>
                                    <strong><t t-esc="doc.paid_by.name or ''"/></strong><br/>
                                    <span style="font-size: 8px; color: #666;">
                                        <t t-if="doc.paid_date">Date: <t t-esc="doc.paid_date.strftime('%Y-%m-%d %H:%M')"/></t>
                                    </span>
                                </div>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>

</odoo>
