<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Allowance Rate Tree View -->
    <record id="view_ffm_allowance_rate_tree" model="ir.ui.view">
        <field name="name">ffm.allowance.rate.tree</field>
        <field name="model">ffm.allowance.rate</field>
        <field name="arch" type="xml">
            <tree string="Allowance Rates by Designation" editable="bottom">
                <field name="job_id"/>
                <field name="da_per_day"/>
                <field name="motorcycle_maintenance_per_month"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Allowance Rate Form View -->
    <record id="view_ffm_allowance_rate_form" model="ir.ui.view">
        <field name="name">ffm.allowance.rate.form</field>
        <field name="model">ffm.allowance.rate</field>
        <field name="arch" type="xml">
            <form string="Allowance Rate">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <group>
                        <group string="Designation">
                            <field name="job_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Standard Rates (BDT)">
                            <field name="da_per_day"/>
                            <field name="motorcycle_maintenance_per_month"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Internal Notes">
                            <field name="notes" placeholder="Policy details or specific remarks..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Allowance Rate Search View -->
    <record id="view_ffm_allowance_rate_search" model="ir.ui.view">
        <field name="name">ffm.allowance.rate.search</field>
        <field name="model">ffm.allowance.rate</field>
        <field name="arch" type="xml">
            <search string="Search Allowance Rates">
                <field name="job_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ffm_allowance_rate" model="ir.actions.act_window">
        <field name="name">Allowance Rates</field>
        <field name="res_model">ffm.allowance.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define daily allowance and motorcycle maintenance rates by designation.
            </p>
        </field>
    </record>

    <!-- Menuitem under Configuration -->
    <menuitem id="menu_ffm_config_allowance_rate"
        name="Allowance Rates"
        parent="field_force_management.menu_ffm_config"
        sequence="40"
        action="action_ffm_allowance_rate"
        groups="field_force_management.group_ffm_admin,field_force_management.group_ffm_director,field_force_management.group_ffm_nsm"/>

</odoo>
