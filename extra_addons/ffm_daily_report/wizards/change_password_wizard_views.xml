<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ffm_change_password_wizard_form" model="ir.ui.view">
        <field name="name">ffm.change.password.wizard.form</field>
        <field name="model">ffm.change.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Set / Reset User Password">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Password Reset &amp; Assignment:</strong> Enter a new password below. It will immediately update the user's login credential without requiring an email confirmation.
                    </div>
                    <group>
                        <group string="Account Information">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="login"/>
                        </group>
                        <group string="New Password">
                            <field name="new_password" password="True" placeholder="Enter new password (min 6 chars)"/>
                            <field name="confirm_password" password="True" placeholder="Confirm new password"/>
                            <field name="send_email"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_password" string="Set Password" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ffm_change_password_wizard" model="ir.actions.act_window">
        <field name="name">Set / Reset Password</field>
        <field name="res_model">ffm.change.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">form</field>
    </record>

    <!-- Action binding on res.users -->
    <record id="action_ffm_change_password_users_binding" model="ir.actions.act_window">
        <field name="name">Set / Reset Password</field>
        <field name="res_model">ffm.change.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
