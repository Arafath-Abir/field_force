<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ffm_travel_log_form" model="ir.ui.view">
        <field name="name">ffm.travel.log.form</field>
        <field name="model">ffm.travel.log</field>
        <field name="arch" type="xml">
            <form string="Travel Log">
                <header>
                    <button name="action_confirm" string="Confirm &amp; Create Bill"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('state','!=','draft')]}"
                        confirm="Confirm this travel log? A vendor bill will be created automatically."/>
                    <button name="action_reset_draft" string="Reset to Draft"
                        type="object"
                        attrs="{'invisible': [('state','!=','confirmed')]}"/>
                    <button name="action_open_vendor_bill" string="View Vendor Bill"
                        type="object" class="btn-secondary"
                        attrs="{'invisible': [('vendor_bill_id','=',False)]}"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <!-- Vendor bill info bar -->
                    <div class="alert alert-success" role="alert"
                         attrs="{'invisible': [('vendor_bill_id','=',False)]}">
                        <b>Vendor Bill Created:</b>
                        <field name="vendor_bill_id" readonly="1" nolabel="1"
                            widget="many2one_clickable" style="display:inline;margin-left:6px;"/>
                        &amp;nbsp;— Status:
                        <field name="vendor_bill_state" readonly="1" nolabel="1"
                            style="display:inline;font-weight:bold;"/>
                    </div>

                    <div class="alert alert-info" role="alert"
                         style="font-size:12px;margin-bottom:8px;"
                         attrs="{'invisible': [('state','!=','draft')]}">
                        <b>How it works:</b> Type and select From / To from Geoapify suggestions →
                        road distance auto-calculated → Fare filled from Fare Config.
                        Click <b>Confirm &amp; Create Bill</b> to lock and generate vendor bill.
                    </div>

                    <group>
                        <group string="Employee">
                            <field name="employee_id"
                                options="{'no_create': True}"
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="date"
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="daily_report_id"
                                domain="[('employee_id','=',employee_id)]"
                                attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="territory_id" readonly="1"/>
                        </group>
                        <group string="Summary">
                            <field name="total_distance_km" readonly="1"/>
                            <field name="total_fare_tk" readonly="1"/>
                            <field name="visited_places" readonly="1"/>
                        </group>
                    </group>

                    <field name="journey_ids"
                        attrs="{'readonly': [('state','!=','draft')]}">
                        <tree editable="bottom" string="Journey Legs">
                            <field name="sequence" widget="handle"/>
                            <field name="place_from_id"
                                widget="ffm_place"
                                string="From"
                                context="{'ffm_place_autocomplete': True}"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                placeholder="Type at least 3 characters…"/>
                            <field name="place_to_id"
                                widget="ffm_place"
                                string="To"
                                context="{'ffm_place_autocomplete': True}"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                                placeholder="Type at least 3 characters…"/>
                            <field name="mode"/>
                            <field name="distance_km" string="Distance (km)" sum="Total km"/>
                            <field name="duration_minutes" string="Duration (min)" optional="hide"/>
                            <field name="fare_tk" string="Fare (Tk)" sum="Total Fare"/>
                            <field name="route_info" string="Route" optional="show"/>
                        </tree>
                    </field>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_ffm_travel_log_tree" model="ir.ui.view">
        <field name="name">ffm.travel.log.tree</field>
        <field name="model">ffm.travel.log</field>
        <field name="arch" type="xml">
            <tree string="Travel Logs"
                decoration-success="state=='confirmed'"
                decoration-muted="state=='draft'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="territory_id"/>
                <field name="total_distance_km" sum="Total km"/>
                <field name="total_fare_tk" sum="Total Fare"/>
                <field name="visited_places"/>
                <field name="state" widget="badge"
                    decoration-success="state=='confirmed'"
                    decoration-warning="state=='draft'"/>
                <field name="vendor_bill_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_ffm_travel_log_search" model="ir.ui.view">
        <field name="name">ffm.travel.log.search</field>
        <field name="model">ffm.travel.log</field>
        <field name="arch" type="xml">
            <search string="Search Travel Logs">
                <field name="employee_id"/>
                <field name="date"/>
                <filter string="My Logs" name="my_logs"
                    domain="[('employee_id.user_id','=',uid)]"/>
                <filter string="Today" name="today"
                    domain="[('date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Draft" name="draft"
                    domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed"
                    domain="[('state','=','confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="grp_employee"
                        context="{'group_by': 'employee_id'}"/>
                    <filter string="Date" name="grp_date"
                        context="{'group_by': 'date:month'}"/>
                    <filter string="Status" name="grp_state"
                        context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ffm_travel_log" model="ir.actions.act_window">
        <field name="name">Travel Log</field>
        <field name="res_model">ffm.travel.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ffm_travel_log_search"/>
        <field name="context">{'search_default_my_logs': 1}</field>
    </record>
</odoo>
