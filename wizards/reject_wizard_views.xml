<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ffm_reject_wizard_form" model="ir.ui.view">
        <field name="name">ffm.reject.wizard.form</field>
        <field name="model">ffm.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Expense Claim">
                <group>
                    <field name="claim_id" readonly="1"/>
                    <field name="reason" placeholder="Enter rejection reason…" required="1"/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object"
                        class="btn-danger"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
